# Copy this file to .env and fill in the values.
# Do NOT commit the .env file to Git!

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Apps Script Web App URL (for template syncing and query analysis)
WEB_APP_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# Secret Token to secure Web App API endpoints (required; must match Apps Script Script Property)
API_SECRET_TOKEN=your_custom_secret_token_here

# HOSxP MySQL Database Connection Config (for local auto report generator)
HOSXP_DB_HOST=127.0.0.1
HOSXP_DB_PORT=3306
HOSXP_DB_NAME=hosxp
HOSXP_DB_USER=your_mysql_username
HOSXP_DB_PASS=your_mysql_password
